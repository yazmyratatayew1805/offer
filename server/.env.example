# Server
PORT=3001
DATABASE_URL=./data/offer-lab.db

# Admin panel: send as header X-Admin-Token or Authorization: Bearer <token>
ADMIN_TOKEN=change-me-to-a-long-random-string

# Telegram bot (@BotFather)
BOT_TOKEN=
# Channel for subscription check (username with @ or numeric chat id)
CHANNEL_USERNAME=@myrat_code
# Optional: numeric channel id if username check fails
CHANNEL_ID=
# Optional secret path segment: POST /telegram/webhook?secret=...
WEBHOOK_SECRET=

# Public contact shown in bot menu
CONTACT_HANDLE=@myratcode
